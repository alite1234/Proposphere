# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/proposalai

# Session signing secret (any long random string)
AUTH_SECRET=

# AI providers — configure at least one; the app falls back to
# heuristic discovery questions if none is set
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama-3.3-70b

# Public base URL used when building shareable proposal links
# NEXT_PUBLIC_APP_URL=https://your-domain.com
